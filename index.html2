<!doctype html>
<html lang="sw">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#100d19">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="ZANGO VIBES V2">
<title>ZANGO VIBES V2</title>
<style>
:root{color-scheme:dark;--v2-bg:#0b0812;--v2-panel:#171221;--v2-line:#30243f;--v2-muted:#a99bbd;--v2-pink:#ec4899;--v2-purple:#8b5cf6}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;background:var(--v2-bg);color:#fff;font-family:system-ui,-apple-system,Segoe UI,sans-serif}
#v2Boot{min-height:100vh;display:grid;place-items:center;padding:24px;text-align:center;background:radial-gradient(ellipse at top,#25143c 0%,#0b0812 60%)}
#v2Boot .v2bootbox{max-width:440px;width:100%;padding:28px;border:1px solid #48345f;border-radius:22px;background:#171221}
#v2Boot h1{margin:0 0 8px;font-size:28px;font-weight:950;letter-spacing:.5px;background:linear-gradient(110deg,#ec4899,#a78bfa);color:transparent;background-clip:text}
#v2Boot p{color:#c4b5d6;line-height:1.5}
#v2Boot .v2spinner{width:30px;height:30px;border:3px solid #49365f;border-top-color:#ec4899;border-radius:50%;margin:18px auto 0;animation:v2spin .8s linear infinite}
@keyframes v2spin{to{transform:rotate(360deg)}}
#v2Boot .v2error{color:#fecaca;text-align:left;overflow-wrap:anywhere;font-size:13px}
</style>
</head>
<body>
<div id="v2Boot"><div class="v2bootbox"><h1>ZANGO VIBES</h1><b>Toleo la V2</b><p>Inafungua akaunti, posts, Music Library na Creator Studio zako...</p><div class="v2spinner"></div><div id="v2Error" class="v2error"></div></div></div>
<script>
(async function startZangoVibesV2(){
  const boot=document.getElementById('v2Boot');
  const errorBox=document.getElementById('v2Error');
  try{
    const response=await fetch('/index.html',{cache:'no-store',credentials:'same-origin'});
    if(!response.ok)throw new Error('Imeshindikana kufungua index.html (HTTP '+response.status+'). Hakikisha v2.html na index.html zipo pamoja kwenye folder kuu ya GitHub.');
    let html=await response.text();
    if(!html.includes('SUPABASE_URL=')||!html.includes('function loadFeed'))throw new Error('index.html haionekani kuwa faili la ZANGO VIBES V1.6 linalotarajiwa.');

    const v2css=`
/* ZANGO VIBES V2 — Reels inspired layout */
:root{--bg:#0b0812;--panel:#171221;--panel2:#21182e;--line:#30243f;--text:#fff;--muted:#aa9bbd;--pink:#ec4899;--purple:#8b5cf6;--grad:linear-gradient(115deg,#ec4899,#8b5cf6)}
body{background:#0b0812;padding-bottom:82px}
.top{background:#0b0812f2;border-bottom:1px solid #2a2038}
.topin{height:62px}
.brand{font-size:23px;letter-spacing:.7px}
.topactions{display:flex;align-items:center;gap:6px}
.topactions .v2-icon{width:40px;height:40px;padding:0;border-radius:13px;background:#21182e;border:1px solid #3a2b4d;color:#fff;font-size:18px;position:relative}
.topactions #logoutBtn{font-size:12px;padding:9px 11px}
#feedTabs{padding-top:9px}
#feedTabs .tab{font-size:12px;padding:8px 15px}
#homePage{padding-top:2px}
#peopleStrip{margin:12px 0 14px;padding:12px;background:#171221;border:1px solid #30243f;border-radius:18px}
.v2-strip-title{font-size:13px;font-weight:800;margin-bottom:10px;letter-spacing:.2px}
.v2-people{display:flex;gap:13px;overflow-x:auto;padding:2px 1px 7px;scrollbar-width:thin}
.v2-person{flex:0 0 66px;width:66px;text-align:center;background:transparent;border:0;padding:0;color:#fff;min-width:0}
.v2-person-ring{width:58px;height:58px;margin:0 auto 6px;border-radius:50%;padding:2px;background:linear-gradient(135deg,#ec4899,#8b5cf6,#f59e0b)}
.v2-person-ring img,.v2-person-ring .v2-person-initial{width:100%;height:100%;display:grid;place-items:center;border-radius:50%;object-fit:cover;border:2px solid #171221;background:#30243f;font-weight:900}
.v2-person-name{font-size:10px;line-height:1.25;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#d8cde5}
#feed{display:flex;flex-direction:column;gap:16px}
.v2-reel{position:relative;overflow:hidden;margin:0;background:#171221;border:1px solid #30243f;border-radius:21px;box-shadow:0 12px 38px #0005}
.v2-reel-head{display:flex;align-items:center;gap:10px;padding:12px 13px;background:#171221}
.v2-reel-head .avatar{width:40px;height:40px}
.v2-reel-head .name{font-size:13px}
.v2-reel-head .muted{font-size:11px}
.v2-follow-chip{margin-left:auto;padding:7px 10px;font-size:11px;border-radius:11px}
.v2-media{position:relative;height:min(68vh,680px);min-height:300px;background:#08060d;display:flex;align-items:center;justify-content:center;overflow:hidden}
.v2-media img,.v2-media video{width:100%;height:100%;max-height:680px;object-fit:cover;display:block;background:#08060d}
.v2-media.v2-no-media{height:auto;min-height:250px;padding:34px 22px;display:block;background:radial-gradient(ellipse at top right,#38204d,#100c18 70%)}
.v2-no-media .v2-no-media-text{font-size:22px;line-height:1.5;font-weight:650;white-space:pre-wrap;overflow-wrap:anywhere}
.v2-overlay{position:absolute;left:0;right:0;bottom:0;padding:65px 74px 15px 14px;background:linear-gradient(transparent,#08060de8);pointer-events:none}
.v2-caption{font-size:14px;line-height:1.45;white-space:pre-wrap;overflow-wrap:anywhere;text-shadow:0 1px 5px #000}
.v2-location{font-size:11px;color:#e5d7f3;margin-top:7px}
.v2-side{position:absolute;right:10px;bottom:18px;display:flex;flex-direction:column;gap:12px;align-items:center;z-index:2}
.v2-side button{width:49px;height:49px;border-radius:50%;padding:0;background:#171221d9;border:1px solid #ffffff35;color:#fff;font-size:20px;backdrop-filter:blur(8px)}
.v2-side button.v2-liked{color:#fb7185;border-color:#fb7185}
.v2-side small{font-size:10px;color:#fff;text-shadow:0 1px 4px #000}
.v2-side .v2-action{display:flex;flex-direction:column;align-items:center;gap:3px}
.v2-music{padding:10px 13px;background:#20182b;border-top:1px solid #30243f}
.v2-music b{font-size:12px}
.v2-music .muted{font-size:11px}
.v2-music audio{width:100%;height:34px;margin-top:6px}
.v2-text-footer{padding:10px 13px;color:#c7b8d7;font-size:11px;display:flex;justify-content:space-between;gap:8px}
.v2-empty{padding:25px 18px;border:1px solid #30243f;border-radius:18px;background:#171221;text-align:center;color:#c9bad8;line-height:1.5}
.bottom{background:#130f1cf7;border-top:1px solid #30243f;display:flex;gap:3px;padding:7px 8px calc(7px + env(safe-area-inset-bottom));}
.bottom button{min-width:0;max-width:none;flex:1;padding:7px 3px;color:#a99bbd;font-size:10px;border-radius:13px}
.bottom button.active{background:#322344;color:#fff}
.bottom span{font-size:20px}
#notificationBadge{position:absolute;top:1px;right:1px}
.card{background:#171221;border-color:#30243f}
.modalbox{background:#171221;border-color:#3c2c50}
@media(min-width:700px){body{padding-bottom:20px}.bottom{position:static;max-width:720px;margin:14px auto;background:transparent;border:0;padding:10px}.bottom button{border:1px solid #30243f;border-radius:13px}.v2-media{height:620px}}
@media(max-width:390px){.v2-media{min-height:280px;height:62vh}.v2-side{right:7px;bottom:14px;gap:9px}.v2-side button{width:44px;height:44px}.v2-overlay{padding-right:65px}}
`;
    html=html.replace('</style>',v2css+'\n</style>');
    html=html.replace('<title>ZANGO VIBES V1.6 — Creator Studio</title>','<title>ZANGO VIBES V2 — Reels</title>');

    const oldLogout='<button class="ghost" id="logoutBtn" style="display:none">Toka</button>';
    const newHeader=`<div class="topactions">
   <button class="v2-icon" data-page="notifications" title="Notifications" aria-label="Notifications">♧<small id="notificationBadge" class="badge-count hidden">0</small></button>
   <button class="v2-icon" data-page="chat" title="Chat" aria-label="Chat">✉</button>
   <button class="v2-icon hidden" id="adminNav" data-page="admin" title="Admin" aria-label="Admin">⚙</button>
   <button class="ghost" id="logoutBtn" style="display:none">Toka</button>
  </div>`;
    if(!html.includes(oldLogout))throw new Error('Sehemu ya header ya V1.6 haikupatikana; sijaendelea kubadilisha faili.');
    html=html.replace(oldLogout,newHeader);

    const oldFeed='<div id="feed" class="loader">Inapakia posts...</div>';
    const newFeed=`<div id="peopleStrip"><div class="v2-strip-title">Watu wa VIBES</div><div class="v2-people"><div class="muted small">Inapakia creators...</div></div></div>
  <div id="feed" class="loader">Inapakia posts...</div>`;
    if(!html.includes(oldFeed))throw new Error('Sehemu ya feed haikupatikana.');
    html=html.replace(oldFeed,newFeed);

    const nav=`<nav class="bottom hidden" id="bottomNav">
 <button class="active" data-page="home"><span>⌂</span>Home</button>
 <button data-page="search"><span>⌕</span>Tafuta</button>
 <button data-page="create"><span>＋</span>Create</button>
 <button data-page="music"><span>♫</span>Muziki</button>
 <button data-page="profile"><span>◉</span>Profile</button>
</nav>`;
    html=html.replace(/<nav class="bottom hidden" id="bottomNav">[\s\S]*?<\/nav>/,nav);
    html=html.replace('async function loadFeed(){','async function loadFeedV1(){');

    const v2js=new TextDecoder().decode(Uint8Array.from(atob(''),ch=>ch.charCodeAt(0)));
    if(!html.includes('init();'))throw new Error('Sehemu ya kuanzisha app haikupatikana.');
    html=html.replace('init();',v2js+'\ninit();');

    document.open();document.write(html);document.close();
  }catch(error){
    const p=errorBox||boot;
    p.textContent=error?.message||String(error);
    if(boot)boot.style.display='grid';
    console.error('ZANGO VIBES V2 boot error:',error);
  }
})();
</script>
</body>
</html>
